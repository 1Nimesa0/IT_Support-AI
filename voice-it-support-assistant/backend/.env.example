# Groq Cloud API Key (for whisper-large-v3 and llama-3.3-70b-versatile)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key fallback
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Vietnamese Natural Speech Voice (Azure Edge-TTS)
# Options: vi-VN-HoaiMyNeural (female), vi-VN-NamMinhNeural (male)
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Force offline rule-based mock engine (useful for automated testing)
FORCE_MOCK=false
